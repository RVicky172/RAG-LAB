# Settings for the project. Copy to .env and adjust: cp .env.example .env
# app/shared/config.py reads these; every one has a default, so a missing line is fine.
# The values below are for running locally. AWS values are in docs/04-deploy-on-aws.md.
# .env is git-ignored: never commit it (it holds the API key on AWS).

# --- Vector database (Qdrant, started by docker compose) -----------------------
QDRANT_URL=http://localhost:6333
COLLECTION=papers                      # the Qdrant "table" that holds the chunks

# --- Embedding model (turns text into vectors, runs on the CPU) ---------------
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- LLM: any OpenAI-compatible server (LM Studio locally, Bedrock on AWS) -----
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio                  # LM Studio accepts any key; on AWS this is the Bedrock API key

# Most tokens one LLM call can hold (prompt + reply). Must match how the model was
# loaded: lms load openai/gpt-oss-20b --context-length 32768. Bedrock: 131072.
# Only used to show "% of the context window" in the eval reports.
CONTEXT_WINDOW=32768

# --- Tracing (Arize Phoenix, started by docker compose) -----------------------
PHOENIX_URL=http://localhost:6006      # web UI, and where the app sends its traces
TRACING=true                           # false = run without Phoenix (nothing is recorded)
